# 삑(Bbik) 백엔드 환경변수 예시 — 이 파일을 .env 로 복사해 값을 채운다.
# 실제 키/인증서는 git이 아닌 별도 채널로 전달한다. (.env, *.key, *.pem 은 .gitignore + settings deny 로 이중 차단)

# ── 서버 ──
NODE_ENV=development
PORT=3000

# ── 자체 JWT (BL-001 우리 토큰) ──
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=14d

# ── 토스 앱인토스 OAuth (F-001 / BL-001, mTLS 필수) ──
# Base URL: https://apps-in-toss-api.toss.im
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
# mTLS 인증서 (콘솔 발급 — 없으면 generate-token 호출 불가). 내용 또는 경로, 둘 중 하나.
#  · 로컬 dev: 파일 경로(backend/secrets/ 에 zip 추출)
TOSS_MTLS_CERT_PATH=./secrets/bbik-prod-mtls_public.crt
TOSS_MTLS_KEY_PATH=./secrets/bbik-prod-mtls_private.key
TOSS_MTLS_CA_PATH=
#  · Fly 프로덕션: PEM 내용을 fly secrets 로 주입(휘발성 FS라 파일 못 올림). 내용이 경로보다 우선.
#    fly secrets set TOSS_MTLS_CERT="$(cat backend/secrets/bbik-prod-mtls_public.crt)"
#    fly secrets set TOSS_MTLS_KEY="$(cat backend/secrets/bbik-prod-mtls_private.key)"
# TOSS_MTLS_CERT=
# TOSS_MTLS_KEY=
# TOSS_MTLS_CA=
# 개인정보(name 등) AES-256-GCM 복호화 키/AAD (콘솔 발급, base64)
TOSS_PII_DECRYPT_KEY=
TOSS_PII_AAD=

# ── 라쿠텐 Product Search API (F-003 / BL-003) ──
RAKUTEN_API_BASE_URL=https://openapi.rakuten.co.jp/ichibaproduct/api/Product/Search/20250801
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
RAKUTEN_TIMEOUT_MS=5000

# ── Gemini API (F-003 사진 추출·ai 판단 전용, 번역 X) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# ── 번역 API (DeepL 구현체, BR-006 일→한) ──
TRANSLATION_PROVIDER=deepl
DEEPL_API_KEY=
# 무료: https://api-free.deepl.com / 유료: https://api.deepl.com
DEEPL_API_BASE_URL=https://api-free.deepl.com

# ── Supabase (service_role 키 — 서버 전용, 클라이언트 노출 금지) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
